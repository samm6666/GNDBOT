# GND Control agent settings. Copy to control/agent/.env (setup-vps.sh does this for you).

# Generated by: npm run keygen   (paste the same key into the desktop app)
CONTROL_API_KEY=

# The agent only listens on an internal address and a reverse proxy exposes it over HTTPS.
# With Coolify use the docker0 address (usually 172.17.0.1) so Traefik can reach it.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=7420

# Optional: Lavalink HTTP check, e.g. http://127.0.0.1:2333 with the password from lavalink/application.yml
LAVALINK_URL=
LAVALINK_PASSWORD=

# Reports for Claude: a fine-grained GitHub token with "Issues: Read and write"
# on this one repository only.
GITHUB_TOKEN=
GITHUB_REPO=samm6666/GNDBOT-v2

# Open a GitHub issue automatically when a bot crashes 3 times in 10 minutes.
AUTO_REPORT=true
AUTO_REPORT_CRASHES=3
AUTO_REPORT_WINDOW_MIN=10

# Branch used by the "update from GitHub" button (empty = current branch).
UPDATE_BRANCH=
